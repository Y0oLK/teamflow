# ==============================================================================
# TeamFlow — Multi-Tenant SaaS Environment Variables (Template)
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Server
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=teamflow_user
POSTGRES_PASSWORD=teamflow_password
POSTGRES_DB=teamflow_db
POSTGRES_PORT=5432
# Connection string for Prisma ORM
DATABASE_URL=postgresql://teamflow_user:teamflow_password@localhost:5432/teamflow_db?schema=public

# ------------------------------------------------------------------------------
# Redis Cache & Pub/Sub
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Authentication & Security Secrets
# In production, generate cryptographically random 64-byte hex strings
# Example: openssl rand -hex 64
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=development_jwt_access_secret_min_32_characters_long_for_security!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=development_jwt_refresh_secret_min_32_characters_long_for_security!
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECRET=development_cookie_secret_min_32_characters_long_for_signing!

# ------------------------------------------------------------------------------
# Storage / S3 / MinIO (Configured for future phases)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=teamflow-attachments
S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# Email / SMTP (Configured for development / Mailhog or Ethereal)
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@teamflow.local

